generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 📋 ENUMS
// ==========================================

enum UserRole {
  PRODUCAO
  GALPAO
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ServiceOrderStatus {
  DRAFT
  READY
  ACTIVE
  PENDING
  CANCELED
}

enum ServiceOrderItemStatus {
  ADDED
  REMOVED
}

// STATUS DO ITEM FÍSICO
enum PhysicalItemStatus {
  AVAILABLE      // Disponível no galpão
  RESERVED       // Separado/em uso em uma Ordem de Serviço
  MAINTENANCE    // Quebrado / Em manutenção
  REMOVED        // Descartado / Perdido
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  isVerified    Boolean        @default(false)
  otpCode       String?
  otpExpires    DateTime?
  refreshToken  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(PRODUCAO)
  status        UserStatus     @default(ACTIVE)
  serviceOrders ServiceOrder[]
}

model Event {
  id            String         @id @default(uuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  status        String
  createdAt     DateTime       @default(now())
  addressId     String
  address       Address        @relation(fields: [addressId], references: [id])
  serviceOrders ServiceOrder[]
}

model Address {
  id               String            @id @default(uuid())
  street           String?
  number           String?
  city             String?
  state            String?
  zipCode          String?
  latitude         Float?
  longitude        Float?
  events           Event[]
  operationalUnits OperationalUnit[]
}

model OperationalUnit {
  id            String             @id @default(uuid())
  name          String
  addressId     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  address       Address?           @relation(fields: [addressId], references: [id])
  
  items         ServiceOrderItem[]
  physicalItems PhysicalItem[]     // <- Relacionamento com os itens físicos no galpão
}

model ServiceOrder {
  id           String             @id @default(uuid())
  eventId      String
  userId       String
  createdAt    DateTime           @default(now())
  missingItems Json?
  supplier     String?
  updatedAt    DateTime           @updatedAt
  status       ServiceOrderStatus @default(DRAFT)
  event        Event              @relation(fields: [eventId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  items        ServiceOrderItem[]
}

model MaterialCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  materials Material[]
}

model Material {
  id            String                      @id @default(uuid())
  name          String
  categoryId    String
  stock         Int                         @default(0) // Usado para itens em massa (parafusos)
  movements     InventoryMovement[]
  category      MaterialCategory            @relation(fields: [categoryId], references: [id])
  orderItems    ServiceOrderItem[]
  templates     StructureMaterialTemplate[]
  physicalItems PhysicalItem[]              // <- Relacionamento: 1 Material tem N Itens Físicos (ex: 10 Treliças individuais)

  @@unique([name, categoryId])
}

model StructureType {
  id         String      @id @default(uuid())
  name       String      @unique
  structures Structure[]
}

model Structure {
  id              String                      @id @default(uuid())
  structureTypeId String
  name            String
  type            StructureType               @relation(fields: [structureTypeId], references: [id])
  templates       StructureMaterialTemplate[]
}

model StructureMaterialTemplate {
  id          String    @id @default(uuid())
  structureId String
  materialId  String
  quantity    Int
  material    Material  @relation(fields: [materialId], references: [id])
  structure   Structure @relation(fields: [structureId], references: [id])

  @@unique([structureId, materialId])
}

model ServiceOrderItem {
  id                String                 @id @default(uuid())
  serviceOrderId    String
  materialId        String
  quantity          Int
  createdAt         DateTime               @default(now())
  operationalUnitId String
  status            ServiceOrderItemStatus @default(ADDED)
  updatedAt         DateTime               @updatedAt
  material          Material               @relation(fields: [materialId], references: [id])
  operationalUnit   OperationalUnit        @relation(fields: [operationalUnitId], references: [id])
  serviceOrder      ServiceOrder           @relation(fields: [serviceOrderId], references: [id])
  
  physicalItems     PhysicalItem[]         // <- Relacionamento: Quais itens físicos específicos foram separados para atender essa quantidade?
}

// ==========================================
// 📦 NOVO: CONTROLE DE ATIVOS FÍSICOS INDIVIDUAIS
// ==========================================
model PhysicalItem {
  id                 String             @id @default(uuid()) // Pode ser usado como Código de Barras / QR Code
  materialId         String
  operationalUnitId  String
  serviceOrderItemId String?            // Opcional: Só é preenchido quando o item é separado/reservado para uma OS
  status             PhysicalItemStatus @default(AVAILABLE)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  material           Material           @relation(fields: [materialId], references: [id])
  operationalUnit    OperationalUnit    @relation(fields: [operationalUnitId], references: [id])
  serviceOrderItem   ServiceOrderItem?  @relation(fields: [serviceOrderItemId], references: [id])
}

model InventoryMovement {
  id         String   @id @default(uuid())
  materialId String
  type       String
  quantity   Int
  date       DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id])
}
