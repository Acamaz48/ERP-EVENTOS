// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PRODUCAO
  GALPAO
  ADMIN
}

// <- ADICIONADO: Para soft delete de usuários
enum UserStatus {
  ACTIVE
  INACTIVE
}

// <- ALTERADO: Novos status do fluxo de ping-pong (Produção <-> Galpão)
enum ServiceOrderStatus {
  DRAFT      // Criado pela produção (rascunho)
  ACTIVE     // Enviado para galpão
  PENDING    // Retornou para produção para ajuste
  READY      // Validado e finalizado
  CANCELED   // Cancelado
}

// <- ADICIONADO: Para rastreabilidade de itens (Event Sourcing)
enum ServiceOrderItemStatus {
  ADDED
  REMOVED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  role         UserRole   @default(PRODUCAO)
  status       UserStatus @default(ACTIVE) // <- ADICIONADO: Status do usuário (Soft Delete)
  isVerified   Boolean    @default(false)
  otpCode      String?
  otpExpires   DateTime?
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  serviceOrders ServiceOrder[]
}

model Event {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   // PENDING, ACTIVE, FINISHED

  // Relacionamento com Endereço
  addressId String
  address   Address  @relation(fields: [addressId], references: [id])

  serviceOrders ServiceOrder[]
  createdAt     DateTime @default(now())
}

model Address {
  id        String  @id @default(uuid())
  street    String? // Rua/Avenida (Opcional)
  number    String? // Número (Opcional)
  city      String? // Cidade (Opcional)
  state     String? // Estado (Opcional)
  zipCode   String? // CEP (Opcional)
  latitude  Float
  longitude Float

  events           Event[]
  operationalUnits OperationalUnit[]
}

model OperationalUnit {
  id        String   @id @default(uuid())
  name      String   // Ex: Galpão Principal, Filial SP
  
  // <- ALTERADO: Relacionamento com Endereço agora é OPCIONAL
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  // <- ADICIONADO: Relacionamento com os itens da Ordem de Serviço
  items     ServiceOrderItem[]

  createdAt DateTime @default(now()) // <- ADICIONADO
  updatedAt DateTime @updatedAt      // <- ADICIONADO
}

model ServiceOrder {
  id           String             @id @default(uuid())
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id])
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  
  // <- ALTERADO: O padrão agora é DRAFT, pois a Produção cria o rascunho antes de enviar
  status       ServiceOrderStatus @default(DRAFT)
  supplier     String?            // Dados do fornecedor
  missingItems Json?              // Mantido para manter histórico de observações/erros
  
  items        ServiceOrderItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt 
}

model MaterialCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  materials Material[]
}

model Material {
  id         String           @id @default(uuid())
  name       String
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  stock      Int              @default(0)

  templates  StructureMaterialTemplate[]
  movements  InventoryMovement[]
  orderItems ServiceOrderItem[]

  @@unique([name, categoryId]) 
}

model StructureType {
  id         String      @id @default(uuid())
  name       String      @unique // Tenda, Treliçado, Galpão
  structures Structure[]
}

model Structure {
  id              String        @id @default(uuid())
  structureTypeId String
  type            StructureType @relation(fields: [structureTypeId], references: [id])
  name            String        // 10x10, Q30, Grande

  templates       StructureMaterialTemplate[]
}

// Gabarito de Materiais
model StructureMaterialTemplate {
  id          String    @id @default(uuid())
  structureId String
  structure   Structure @relation(fields: [structureId], references: [id])
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id])
  quantity    Int

  @@unique([structureId, materialId])
}

model ServiceOrderItem {
  id                String                 @id @default(uuid())
  quantity          Int
  
  serviceOrderId    String
  serviceOrder      ServiceOrder           @relation(fields: [serviceOrderId], references: [id])
  
  materialId        String
  material          Material               @relation(fields: [materialId], references: [id])

  // <- ADICIONADO: Relacionamento com a Unidade Operacional (Galpão)
  operationalUnitId String
  operationalUnit   OperationalUnit        @relation(fields: [operationalUnitId], references: [id])
  
  // <- ADICIONADO: Status do Item para rastrear se foi incluído ou removido na negociação
  status            ServiceOrderItemStatus @default(ADDED)
  
  // <- ADICIONADO: Timestamps de auditoria
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model InventoryMovement {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  type       String   // IN, OUT
  quantity   Int
  date       DateTime @default(now())
}